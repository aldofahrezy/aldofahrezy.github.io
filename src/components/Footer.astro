---
const year = new Date().getFullYear();
const socials = [
  { label: 'GitHub', href: 'https://github.com/aldofahrezy' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/aldofahrezy' },
];
---
<footer id="contact" class="footer">
  <div class="container-page">
    <div class="hairline"></div>
    <div class="footer-inner">
      <div class="footer-lead">
        <p class="eyebrow">Get in touch</p>
        <h2 class="footer-title">
          Open to Data Science &amp; ML internships, research, and collaborations.
        </h2>
        <a href="mailto:aldofahrezy@gmail.com" class="footer-email metric-num link-line">aldofahrezy@gmail.com</a>
      </div>
      <nav class="footer-links" aria-label="Social and contact">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" class="footer-link link-line">{s.label} <span aria-hidden="true">↗</span></a>
        ))}
        <a href="/resume.pdf" target="_blank" rel="noopener" class="footer-link link-line">Résumé <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© {year} Muhammad Aldo Fahrezy</span>
      <span>Built with Astro · Depok, Indonesia</span>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: clamp(3rem, 7vw, 5rem) 2rem; }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem;
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .footer-lead { max-width: 34rem; }
  .footer-title {
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    line-height: 1.15;
  }
  .footer-email { font-size: 1.05rem; color: var(--accent); }
  .footer-links { display: flex; flex-direction: column; gap: 0.85rem; align-items: flex-start; }
  .footer-link { font-size: 0.95rem; color: var(--ink-2); }
  .footer-link:hover { color: var(--ink); }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
</style>
