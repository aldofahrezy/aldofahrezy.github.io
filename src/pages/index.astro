---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getCollection } from 'astro:content';
import { about, education, experience, honors, skillGroups, languages, certifications } from '../data/profile';

const featured = (await getCollection('projects'))
  .filter((e) => e.data.featured && !e.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Muhammad Aldo Fahrezy — Data Science & AI Engineer">
  <Hero />

  <!-- SELECTED WORK -->
  <section id="work" class="section">
    <div class="container-page">
      <p class="eyebrow reveal">Selected work</p>
      <h2 class="section-title reveal">Case studies</h2>
      <p class="sec-lead measure-wide reveal">
        A few projects worth the depth — each written up with the reasoning behind it, the measured results, and honest limitations.
      </p>
      <div class="featured-list">
        {featured.map((e) => (
          <div class="reveal">
            <ProjectRow
              href={`/projects/${e.id}`}
              domain={e.data.domain}
              title={e.data.title}
              summary={e.data.summary}
              tags={e.data.tags}
              metric={e.data.metrics?.[0] ?? null}
              context={e.data.context}
              families={e.data.families}
            />
          </div>
        ))}
      </div>
      <a href="/projects" class="see-all link-line reveal">See all projects →</a>
    </div>
  </section>

  <!-- ABOUT + EDUCATION -->
  <section id="about" class="section section-alt">
    <div class="container-page">
      <p class="eyebrow reveal">About</p>
      <div class="about-grid">
        <div class="about-text reveal">
          {about.map((p) => <p>{p}</p>)}
        </div>
        <aside class="edu reveal" aria-label="Education">
          <p class="edu-eyebrow">Education</p>
          <h3 class="edu-inst">{education.institution}</h3>
          <p class="edu-degree">{education.degree}</p>
          <p class="edu-meta metric-num">{education.period}</p>
          <div class="edu-gpa">
            <span class="edu-gpa-num metric-num">{education.gpa}</span>
            <span class="edu-gpa-label">Cumulative GPA</span>
          </div>
          <p class="edu-scholar">{education.scholarship}</p>
          <p class="edu-course-label">Relevant coursework</p>
          <ul class="edu-course">
            {education.coursework.map((c) => <li>{c}</li>)}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" class="section">
    <div class="container-page">
      <p class="eyebrow reveal">Experience</p>
      <h2 class="section-title reveal">Leading, teaching, competing</h2>
      <div class="exp-list">
        {experience.map((x) => (
          <div class="exp reveal">
            <div class="exp-head">
              <h3 class="exp-role">{x.role}</h3>
              <span class="exp-period metric-num">{x.period}</span>
            </div>
            <p class="exp-org">{x.org}</p>
            <ul class="exp-points">{x.points.map((p) => <li>{p}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HONORS -->
  <section id="honors" class="section section-alt">
    <div class="container-page">
      <p class="eyebrow reveal">Honors &amp; awards</p>
      <h2 class="section-title reveal">Recognition</h2>
      <div class="honor-grid">
        {honors.map((h) => (
          <div class="honor reveal">
            <span class="honor-level">{h.level}</span>
            <h3 class="honor-title">{h.title}</h3>
            <p class="honor-note">{h.note}</p>
            <p class="honor-meta metric-num">{h.org} · {h.year}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="section">
    <div class="container-page">
      <p class="eyebrow reveal">Skills</p>
      <h2 class="section-title reveal">The toolkit</h2>
      <div class="skills">
        {skillGroups.map((g) => (
          <div class="skill-row reveal">
            <p class="skill-cat">{g.label}</p>
            <ul class="skill-tags">
              {g.items.map((it) => <li class="tag">{it}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <div class="skills-foot reveal">
        <div class="sf-block">
          <p class="skill-cat">Languages</p>
          <ul class="lang-list">
            {languages.map((l) => (
              <li><span class="lang-name">{l.name}</span> <span class="lang-level metric-num">{l.level}</span></li>
            ))}
          </ul>
        </div>
        <div class="sf-block">
          <p class="skill-cat">Certifications</p>
          <ul class="cert-list">
            {certifications.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-title { font-size: clamp(1.7rem, 4vw, 2.4rem); margin-top: 0.5rem; }
  .sec-lead { color: var(--ink-2); font-size: 1.05rem; line-height: 1.6; margin-top: 1rem; }
  .section-alt { background: color-mix(in oklab, var(--ink) 3%, var(--paper)); }

  /* Selected work */
  .featured-list { margin-top: 2.5rem; border-bottom: 1px solid var(--line); }
  .see-all { display: inline-block; margin-top: 1.8rem; font-size: 0.95rem; color: var(--accent); }

  /* About */
  .about-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: 1.5rem;
    align-items: start;
  }
  .about-text { display: flex; flex-direction: column; gap: 1.1rem; }
  .about-text p { font-size: 1.08rem; line-height: 1.7; color: var(--ink-2); }
  .about-text p:first-child { color: var(--ink); font-size: 1.18rem; }

  .edu { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 1.6rem; }
  .edu-eyebrow { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 0.9rem; }
  .edu-inst { font-size: 1.15rem; }
  .edu-degree { color: var(--ink-2); font-size: 0.95rem; margin-top: 0.3rem; }
  .edu-meta { font-size: 0.78rem; color: var(--ink-3); margin-top: 0.5rem; }
  .edu-gpa { display: flex; align-items: baseline; gap: 0.6rem; margin: 1.2rem 0; padding: 0.9rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .edu-gpa-num { font-size: 1.9rem; color: var(--accent); }
  .edu-gpa-label { font-size: 0.8rem; color: var(--ink-3); }
  .edu-scholar { font-size: 0.9rem; color: var(--ink-2); line-height: 1.5; }
  .edu-course-label { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); margin-top: 1.3rem; margin-bottom: 0.7rem; }
  .edu-course { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .edu-course li { font-size: 0.78rem; color: var(--ink-2); background: var(--paper); border: 1px solid var(--line); padding: 0.25rem 0.6rem; border-radius: 7px; }

  /* Experience */
  .exp-list { margin-top: 2rem; display: flex; flex-direction: column; }
  .exp { padding: 1.8rem 0; border-top: 1px solid var(--line); }
  .exp:last-child { border-bottom: 1px solid var(--line); }
  .exp-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .exp-role { font-size: 1.15rem; }
  .exp-period { font-size: 0.78rem; color: var(--ink-3); white-space: nowrap; }
  .exp-org { color: var(--accent); font-size: 0.92rem; margin-top: 0.3rem; }
  .exp-points { list-style: none; padding: 0; margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem; max-width: 52rem; }
  .exp-points li { position: relative; padding-left: 1.3rem; color: var(--ink-2); font-size: 0.95rem; line-height: 1.55; }
  .exp-points li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 7px; height: 1.5px; background: var(--accent); }

  /* Honors */
  .honor-grid { margin-top: 2rem; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .honor { background: var(--surface); padding: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .honor-level { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .honor-title { font-size: 1.05rem; line-height: 1.3; }
  .honor-note { font-size: 0.9rem; color: var(--ink-2); line-height: 1.5; flex: 1; }
  .honor-meta { font-size: 0.75rem; color: var(--ink-3); }

  /* Skills */
  .skills { display: flex; flex-direction: column; margin-top: 1.5rem; }
  .skill-row { display: grid; grid-template-columns: 15rem 1fr; gap: 1.5rem; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .skill-row:last-child { border-bottom: 1px solid var(--line); }
  .skill-cat { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.06em; color: var(--ink-3); text-transform: uppercase; }
  .skill-tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag { font-size: 0.85rem; color: var(--ink); background: var(--surface); border: 1px solid var(--line); padding: 0.35rem 0.75rem; border-radius: 8px; transition: border-color 0.2s ease, color 0.2s ease; }
  .tag:hover { border-color: var(--accent); color: var(--accent); }

  .skills-foot { display: grid; grid-template-columns: 15rem 1fr 1fr; gap: 1.5rem; margin-top: 2.5rem; }
  .lang-list, .cert-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .lang-list li { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9rem; color: var(--ink-2); border-bottom: 1px dotted var(--line); padding-bottom: 0.4rem; }
  .lang-level { color: var(--ink-3); font-size: 0.8rem; white-space: nowrap; }
  .cert-list li { font-size: 0.9rem; color: var(--ink-2); }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; }
    .honor-grid { grid-template-columns: 1fr; }
    .skill-row { grid-template-columns: 1fr; gap: 0.8rem; }
    .skills-foot { grid-template-columns: 1fr; gap: 2rem; }
    .sf-block { margin-bottom: 0; }
  }
</style>
